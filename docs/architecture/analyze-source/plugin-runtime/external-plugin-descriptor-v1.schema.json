{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arch-view.dev/schemas/external-plugin-descriptor-v1.json",
  "title": "Arch View external analyzer plugin descriptor v1",
  "examples": [
    {
      "schema_version": "arch-view.plugin/v1",
      "manifest": {
        "id": "org.example.external-fixture",
        "version": "1.0.0",
        "language": "fixture",
        "api_version": "arch-view.analyzer/v1",
        "detection_markers": [{"kind": "file", "value": "fixture.marker", "weight": 1}],
        "capabilities": ["detect", "static_dependencies"],
        "options": []
      },
      "command": "python",
      "args": ["analyzer.py"],
      "working_directory": "."
    }
  ],
  "type": "object",
  "required": ["schema_version", "manifest", "command"],
  "properties": {
    "schema_version": { "const": "arch-view.plugin/v1" },
    "manifest": {
      "$ref": "external-protocol-v1.schema.json#/$defs/manifest"
    },
    "command": { "type": "string", "minLength": 1 },
    "args": {
      "type": "array",
      "items": { "type": "string" }
    },
    "working_directory": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
