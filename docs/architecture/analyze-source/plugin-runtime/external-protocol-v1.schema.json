{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arch-view.dev/schemas/analyzer-protocol-v1.json",
  "title": "Arch View external analyzer protocol v1",
  "description": "NDJSON frame schema for one request handled by one external analyzer process.",
  "examples": [
    {
      "type": "hello",
      "protocol": "arch-view.analyzer/v1",
      "manifest": {
        "id": "org.example.external-fixture",
        "version": "1.0.0",
        "language": "fixture",
        "api_version": "arch-view.analyzer/v1",
        "detection_markers": [{"kind": "file", "value": "fixture.marker", "weight": 1}],
        "capabilities": ["detect", "static_dependencies"],
        "options": []
      }
    },
    {"type": "detect", "request_id": "req-1", "project_root": "/repo"},
    {"type": "candidate", "request_id": "req-1", "candidate": {"analyzer_id": "org.example.external-fixture", "confidence": 1, "matched_markers": ["fixture.marker"], "reason": "detected by fixture.marker"}},
    {"type": "done", "request_id": "req-1", "status": "complete"}
  ],
  "oneOf": [
    { "$ref": "#/$defs/hello" },
    { "$ref": "#/$defs/detect" },
    { "$ref": "#/$defs/analyze" },
    { "$ref": "#/$defs/cancel" },
    { "$ref": "#/$defs/candidate" },
    { "$ref": "#/$defs/result" },
    { "$ref": "#/$defs/diagnostic" },
    { "$ref": "#/$defs/done" },
    { "$ref": "#/$defs/fatal" }
  ],
  "$defs": {
    "manifest": {
      "type": "object",
      "required": [
        "id",
        "version",
        "language",
        "api_version",
        "detection_markers",
        "capabilities",
        "options"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
        "language": { "type": "string", "minLength": 1 },
        "api_version": { "type": "string", "pattern": "^arch-view\\.analyzer/v1(?:\\.[0-9]+)?$" },
        "detection_markers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["kind", "value", "weight"],
            "properties": {
              "kind": { "type": "string", "minLength": 1 },
              "value": { "type": "string", "minLength": 1 },
              "weight": { "type": "number", "exclusiveMinimum": 0 }
            },
            "additionalProperties": false
          }
        },
        "capabilities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type", "default", "sensitive"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "type": { "type": "string", "minLength": 1 },
              "default": {},
              "allowed_values": {
                "type": "array",
                "items": { "type": "string" }
              },
              "description": { "type": "string" },
              "sensitive": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "frameRequest": {
      "type": "object",
      "required": ["type", "request_id"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "request_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "hello": {
      "type": "object",
      "required": ["type", "protocol", "manifest"],
      "properties": {
        "type": { "const": "hello" },
        "protocol": { "type": "string", "pattern": "^arch-view\\.analyzer/v1(?:\\.[0-9]+)?$" },
        "manifest": { "$ref": "#/$defs/manifest" }
      },
      "not": { "required": ["request_id"] },
      "additionalProperties": true
    },
    "detect": {
      "allOf": [
        { "$ref": "#/$defs/frameRequest" },
        {
          "type": "object",
          "required": ["type", "request_id", "project_root"],
          "properties": {
            "type": { "const": "detect" },
            "project_root": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "analyze": {
      "allOf": [
        { "$ref": "#/$defs/frameRequest" },
        {
          "type": "object",
          "required": ["type", "request_id", "project_root", "selection", "options"],
          "properties": {
            "type": { "const": "analyze" },
            "project_root": { "type": "string", "minLength": 1 },
            "selection": { "type": "object" },
            "options": { "type": "object" }
          }
        }
      ]
    },
    "cancel": {
      "allOf": [
        { "$ref": "#/$defs/frameRequest" },
        {
          "type": "object",
          "required": ["type", "request_id"],
          "properties": {
            "type": { "const": "cancel" },
            "reason": { "type": "string" }
          }
        }
      ]
    },
    "candidate": {
      "allOf": [
        { "$ref": "#/$defs/frameRequest" },
        {
          "type": "object",
          "required": ["type", "request_id", "candidate"],
          "properties": {
            "type": { "const": "candidate" },
            "candidate": { "$ref": "#/$defs/detectionCandidate" }
          }
        }
      ]
    },
    "result": {
      "allOf": [
        { "$ref": "#/$defs/frameRequest" },
        {
          "type": "object",
          "required": ["type", "request_id", "result"],
          "properties": {
            "type": { "const": "result" },
            "result": { "$ref": "#/$defs/analysisResult" }
          }
        }
      ]
    },
    "diagnostic": {
      "allOf": [
        { "$ref": "#/$defs/frameRequest" },
        {
          "type": "object",
          "required": ["type", "request_id", "diagnostic"],
          "properties": {
            "type": { "const": "diagnostic" },
            "diagnostic": { "$ref": "#/$defs/diagnosticPayload" }
          }
        }
      ]
    },
    "done": {
      "allOf": [
        { "$ref": "#/$defs/frameRequest" },
        {
          "type": "object",
          "required": ["type", "request_id", "status"],
          "properties": {
            "type": { "const": "done" },
            "status": {
              "enum": ["complete", "partial", "failed", "cancelled"]
            }
          }
        }
      ]
    },
    "fatal": {
      "allOf": [
        { "$ref": "#/$defs/frameRequest" },
        {
          "type": "object",
          "required": ["type", "request_id", "code", "message"],
          "properties": {
            "type": { "const": "fatal" },
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 },
            "details": { "type": "object" }
          }
        }
      ]
    },
    "detectionCandidate": {
      "type": "object",
      "required": ["analyzer_id", "confidence", "reason"],
      "properties": {
        "analyzer_id": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "matched_markers": { "type": "array", "items": { "type": "string" } },
        "boundary_hint": { "type": "string" },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "diagnosticPayload": {
      "type": "object",
      "required": ["code", "severity", "message", "recoverable"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["info", "warning", "error"] },
        "message": { "type": "string", "minLength": 1 },
        "subject": { "type": "string" },
        "path": { "type": "string" },
        "location": { "type": "object" },
        "recoverable": { "type": "boolean" },
        "metadata": { "type": "object" }
      },
      "additionalProperties": false
    },
    "analysisResult": {
      "type": "object",
      "required": ["run_id", "status", "analyzer", "project", "modules", "relationships", "references", "source_references", "diagnostics", "summary"],
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["complete", "partial", "failed", "cancelled"] },
        "analyzer": { "type": "object", "required": ["id", "version", "language", "api_version"] },
        "project": { "type": "object", "required": ["root_label", "boundary"] },
        "modules": { "type": "array" },
        "relationships": { "type": "array" },
        "references": { "type": "array" },
        "source_references": { "type": "array" },
        "diagnostics": { "type": "array" },
        "summary": { "type": "object" },
        "options_fingerprint": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
